{
  "opencollection": "1.0.0",
  "info": {
    "name": "Triple Whale API Keys API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "API Keys",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Validate Your Triple Whale API Key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.triplewhale.com/api/v2/users/api-keys/me",
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Enter your API key in Credentials > Header to the right and click \"Try it!\" to test its validity.\n"
        }
      ]
    }
  ],
  "bundled": true
}